<%- layout("/layouts/boilerplate") %>

<style>

body{
    background:#f8f9fa;
}

.booking-card{
    border:none;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
    transition:.3s;
    padding: 1rem;
}

.booking-card:hover{
    transform:translateY(-2px);
    box-shadow:0 16px 35px rgba(0,0,0,.15);
}

.booking-img{
    height:250px;
    object-fit:cover;
    padding:18px;
    border-radius:1rem;
}

.info-box{
    background:#f8f9fa;
    border-radius:15px;
    padding:15px;
    text-align:center;
}

.price{
    color:#198754;
    font-size:1.35rem;
    font-weight:700;
}

.status-badge{
    padding:8px 18px;
    border-radius:30px;
    font-size:.9rem;
}

.action-btn{
    border-radius:10px;
    min-width:110px;
}

.empty-card{
    border:none;
    border-radius:20px;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
}

</style>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="fa-solid fa-calendar-check" style="color: #fe433d !important;"></i>

                My Bookings

            </h2>

            <p class="text-muted mb-0">

                Manage all your upcoming and completed trips.

            </p>

        </div>

    </div>


    <% if(bookings.length===0){ %>

    <div class="card empty-card">

        <div class="card-body text-center py-5">


            <h3>No Bookings Yet</h3>

            <p class="text-muted">

                Start exploring amazing destinations and book your next stay.

            </p>

            <a href="/listings" class="btn rounded-pill px-4" style="color: #fe433d !important; border-radius: 1rem" >

                Explore Listings

            </a>

        </div>

    </div>

    <% } %>



    <div class="row">

        <% bookings.forEach(booking=>{ %>

        <div class="col-lg-6 mb-4">

            <div class="card booking-card h-100">

                <img
                    src="<%= booking.listing.image.url %>"
                    class="booking-img card-img-top"
                >

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-2">

                        <%= booking.listing.title %>

                    </h3>

                    <p class="text-muted">

                        <i class="fa-solid fa-location-dot text-danger"></i>

                        <%= booking.listing.location %>,
                        <%= booking.listing.country %>

                    </p>

                    <div class="row g-3 my-3">

                        <div class="col-6">

                            <div class="info-box">

                                

                                <small class="d-block text-muted">

                                    Check-In

                                </small>

                                <strong>

                                    <%= booking.checkIn.toDateString() %>

                                </strong>

                            </div>

                        </div>

                        <div class="col-6">

                            <div class="info-box">

                                
                                <small class="d-block text-muted">

                                    Check-Out

                                </small>

                                <strong>

                                    <%= booking.checkOut.toDateString() %>

                                </strong>

                            </div>

                        </div>

                    </div>



                    <div class="row g-3">

                        <div class="col-4">

                            <div class="info-box">

                                <i class="fa-solid fa-users"></i>

                                <small class="d-block text-muted">

                                    Guests

                                </small>

                                <strong>

                                    <%= booking.guests %>

                                </strong>

                            </div>

                        </div>

                        <div class="col-4">

                            <div class="info-box">

                                <i class="fa-solid fa-bed"></i>

                                <small class="d-block text-muted">

                                    Rooms

                                </small>

                                <strong>

                                    <%= booking.rooms %>

                                </strong>

                            </div>

                        </div>

                        <div class="col-4">

                            <div class="info-box">

                                <i class="fa-solid fa-indian-rupee-sign"></i>

                                <small class="d-block text-muted">

                                    Total

                                </small>

                                <div class="price">

                                    ₹<%= booking.totalPrice.toLocaleString("en-IN") %>

                                </div>

                            </div>

                        </div>

                    </div>

                    <hr>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <div>

                            <% if(booking.bookingStatus==="Confirmed"){ %>

                                <span class="badge bg-success status-badge">

        

                                    Confirmed

                                </span>

                            <% } else if(booking.bookingStatus==="Completed"){ %>

                                <span class="badge bg-secondary status-badge">

                                    <i class="fa-solid fa-flag-checkered"></i>

                                    Completed

                                </span>

                            <% } else { %>

                                <span class="badge bg-danger status-badge">

                                    <i class="fa-solid fa-ban"></i>

                                    Cancelled

                                </span>

                            <% } %>

                        </div>


                        <div class="d-flex gap-2">

                            <a
                                href="/listings/<%= booking.listing._id %>"
                                class="btn btn-outline-dark action-btn">

                                

                                View Property

                            </a>

                            <% if(booking.bookingStatus==="Confirmed"){ %>

                            <form
                                action="/bookings/<%= booking._id %>/cancel?_method=PATCH"
                                method="POST">

                                <button
                                    class="btn btn-danger action-btn"
                                    onclick="return confirm('Cancel this booking?')">


                                    Cancel

                                </button>

                            </form>

                            <% } %>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</div>