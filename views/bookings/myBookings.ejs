<%- layout("/layouts/boilerplate") %>

<div class="container mt-5 mb-5">

    <h2 class="fw-bold mb-4">
        <i class="fa-solid fa-calendar-check"></i> My Bookings
    </h2>

    <% if(bookings.length === 0){ %>

        <div class="alert alert-info">
            You haven't booked any property yet.
        </div>

    <% } %>

    <div class="row">

        <% bookings.forEach(booking => { %>

        <div class="col-lg-6 mb-4">

            <div class="card shadow border-0 rounded-4 overflow-hidden h-100">

                
                <img
                    src="<%= booking.listing.image.url %>"
                    class="card-img-top p-4 rounded-4"
                    style="height:300px; object-fit:cover;"
                >


                <div class="card-body p-4">

                    <h4 class="card-title fw-bold mb-3">
                        <%= booking.listing.title %>
                    </h4>

                    <div class="row">

                        <div class="col-6">
                            <small class="text-muted">Check-In</small>
                            <p class="fw-semibold">
                                <%= booking.checkIn.toDateString() %>
                            </p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Check-Out</small>
                            <p class="fw-semibold">
                                <%= booking.checkOut.toDateString() %>
                            </p>
                        </div>

                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">

                        <div>
                            <small class="text-muted">Guests</small>
                            <h6><%= booking.guests %></h6>
                        </div>

                        <div>
                            <small class="text-muted">Rooms</small>
                            <h6><%= booking.rooms %></h6>
                        </div>

                        <div>
                            <small class="text-muted">Total</small>
                            <h6 class="text-success">
                                ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                            </h6>
                        </div>

                    </div>

                    <hr>

                    <div class="d-flex justify-content-between align-items-center">

                        <% if (booking.bookingStatus === "Confirmed") { %>

                            <span class="badge bg-success fs-6">
                                Confirmed
                            </span>

                        <% } else if (booking.bookingStatus === "Cancelled") { %>

                            <span class="badge bg-danger fs-6">
                                Cancelled
                            </span>

                        <% } else { %>

                            <span class="badge bg-secondary fs-6">
                                Completed
                            </span>

                        <% } %>

                        <div>

                            <a href="/listings/<%= booking.listing._id %>"
                                class="btn btn-outline-dark btn-sm">
                                View
                            </a>

                            <% if (booking.bookingStatus === "Confirmed") { %>

                                <form
                                    action="/bookings/<%= booking._id %>/cancel?_method=PATCH"
                                    method="POST"
                                    style="display:inline;">

                                    <button
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Cancel this booking?')">

                                        Cancel

                                    </button>

                                </form>

                            <% } %>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</div>