<h2 class="fw-bold mb-4">
    <i class="fa-solid fa-chart-line"></i>
    Owner Dashboard
</h2>

<div class="row mb-4">

    <div class="col-md-3 mb-3">

        <div class="card shadow-sm border-0 text-center">

            <div class="card-body">

                <i class="fa-solid fa-calendar-check fa-2x text-primary"></i>

                <h3 class="mt-2">
                    <%= totalBookings %>
                </h3>

                <p class="text-muted">
                    Total Bookings
                </p>

            </div>

        </div>

    </div>


    <div class="col-md-3 mb-3">

        <div class="card shadow-sm border-0 text-center">

            <div class="card-body">

                <i class="fa-solid fa-circle-check fa-2x text-success"></i>

                <h3 class="mt-2">
                    <%= activeBookings %>
                </h3>

                <p class="text-muted">
                    Active
                </p>

            </div>

        </div>

    </div>


    <div class="col-md-3 mb-3">

        <div class="card shadow-sm border-0 text-center">

            <div class="card-body">

                <i class="fa-solid fa-check-double fa-2x text-secondary"></i>

                <h3 class="mt-2">
                    <%= completedBookings %>
                </h3>

                <p class="text-muted">
                    Completed
                </p>

            </div>

        </div>

    </div>


    <div class="col-md-3 mb-3">

        <div class="card shadow-sm border-0 text-center">

            <div class="card-body">

                <i class="fa-solid fa-indian-rupee-sign fa-2x text-warning"></i>

                <h3 class="mt-2">

                    ₹<%= totalRevenue.toLocaleString("en-IN") %>

                </h3>

                <p class="text-muted">
                    Revenue
                </p>

            </div>

        </div>

    </div>

</div>

<% if (bookings.length === 0) { %>
    <p>No bookings yet on your listings.</p>
<% } %>

<div class="container">

<% bookings.forEach(booking => { %>

    <div class="card mb-3">
        <div class="card-body">

            <h4><%= booking.listing.title %></h4>

            <p><b>Booked by:</b> <%= booking.user.username %></p>

            <p><b>Check In:</b> <%= booking.checkIn.toDateString() %></p>
            <p><b>Check Out:</b> <%= booking.checkOut.toDateString() %></p>

            <p><b>Guests:</b> <%= booking.guests %></p>
            <p><b>Rooms:</b> <%= booking.rooms %></p>

            <p><b>Total Price:</b> ₹<%= booking.totalPrice %></p>

            <div class="d-flex justify-content-between align-items-center mt-3">

                <div>
                    <b>Status:</b>

                    <% if (booking.bookingStatus === "Confirmed") { %>

                        <span class="badge bg-success">
                            Confirmed
                        </span>

                    <% } else if (booking.bookingStatus === "Cancelled") { %>

                        <span class="badge bg-danger">
                            Cancelled
                        </span>

                    <% } else { %>

                        <span class="badge bg-secondary">
                            Completed
                        </span>

                    <% } %>
                </div>

                <% if (booking.bookingStatus === "Confirmed") { %>

                    <form
                        action="/bookings/<%= booking._id %>/complete?_method=PATCH"
                        method="POST">

                        <button
                            class="btn btn-success btn-sm">

                            Mark Completed

                        </button>

                    </form>

                <% } %>

            </div>

        </div>
    </div>

<% }) %>

</div>