<%- layout("/layouts/boilerplate") %>

<style>

body{
    background:#f8f9fa;
}

.profile-card{
    border:none;
    border-radius:20px;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
    margin-bottom: 2rem !important;
}

.profile-icon{
    font-size:85px;
    color:#6c757d;
}

.stat-card{
    border:none;
    border-radius:18px;
    box-shadow:0 8px 20px rgba(0,0,0,.08);
    transition:.3s;
}

.stat-card:hover{
    transform:translateY(-1px);
}

.listing-card{
    border:none;
    border-radius:18px;
    overflow:hidden;
    transition:.3s;
    box-shadow:0 8px 20px rgba(0,0,0,.08);
}

.listing-card:hover{
    transform:translateY(-1px);
    box-shadow:0 15px 35px rgba(0,0,0,.15);
}

.listing-card img{
    height:220px;
    object-fit:cover;
}

.view-btn{
    background:#fe424d;
    border:none;
}

.view-btn:hover{
    background:#e63946;
}

</style>

<div class="container py-5 mb-5 mt-3">

    <!-- Profile Card -->

    <div class="card profile-card">

        <div class="card-body text-center py-5">

            <i class="fa-solid fa-circle-user profile-icon mb-3"></i>

            <h2 class="fw-bold mb-1">
                <%= user.username %>
            </h2>

            <p class="text-muted mb-3">
                <i class="fa-solid fa-envelope"></i>
                <%= user.email %>
            </p>

            <span class="badge fs-6 px-3 py-2" style="background-color: #fe433d !important; border-radius:1rem;">
                Host Account
            </span>

        </div>

    </div>


    <!-- Stats -->

    <div class="row g-4 mb-5 ">

        <div class="col-md-6">

            <div class="card stat-card">

                <div class="card-body text-center py-4">


                    <h2 class="fw-bold">
                        <%= listings.length %>
                    </h2>

                    <p class="text-muted mb-0">
                        Listings
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card stat-card">

                <div class="card-body text-center py-4">

                    

                    <h2 class="fw-bold">
                        Active
                    </h2>

                    <p class="text-muted mb-0">
                        Hosting Status
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Listings -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            My Listings
        </h2>

        <a href="/listings/new" class="btn" style="background-color: #fe433d !important; border-radius:1rem;">
            <i class="fa-solid fa-plus"></i>
            Add Listing
        </a>

    </div>


    <% if(listings.length===0){ %>

        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <i class="fa-solid fa-house-circle-xmark fa-4x text-secondary mb-3"></i>

                <h4>No listings yet</h4>

                <p class="text-muted">
                    Start hosting by creating your first property.
                </p>

                <a href="/listings/new" class="btn" style="background-color: #fe433d !important; border-radius:1rem;">
                    Create Listing
                </a>

            </div>

        </div>

    <% } %>


    <div class="row">

        <% listings.forEach(listing=>{ %>

        <div class="col-lg-4 col-md-6 mb-4">

            <div class="card listing-card h-100">

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                >

                <div class="card-body">

                    <h5 class="fw-bold">
                        <%= listing.title %>
                    </h5>

                    <p class="text-muted mb-2">

                        <i class="fa-solid fa-location-dot text-danger"></i>

                        <%= listing.location %>, <%= listing.country %>

                    </p>

                    <h5 class="text-success">

                        ₹<%= listing.price.toLocaleString("en-IN") %>

                        <small class="text-muted fs-6">
                            / night
                        </small>

                    </h5>

                </div>

                <div class="card-footer bg-white border-0">

                    <a
                        href="/listings/<%= listing._id %>"
                        class="btn btn-danger view-btn w-100">

                        <i class="fa-solid fa-eye"></i>

                        View Property

                    </a>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</div>