<% layout("/layouts/boilerplate") %>

<style>
    img{
        width: 100%;
        height: 300px;
        object-fit: cover;
    }

    .card{
        border: none;
    }

    .card a{
        background-color: #fe424d !important;
        border: none;
    }
</style>

<div class="row mt-3">
    <div class="col-12 col-md-8 offset-md-2">

        <h1>Username: <%= user.username %></h1>
        <p>Email: <%= user.email %></p>

        <% if(listings.length > 0) { %>
        <div class="row row-cols-lg-2 row-cols-md-1 row-cols-sm-1 mt-3">

            <% for(listing of listings) { %>
            <div class="col mb-3">
                <div class="card">
                    <img src="<%= listing.image.url %>" class="card-img-top">

                    <div class="card-body">
                        <h5><%= listing.title %></h5>
                        <p>₹<%= listing.price %></p>

                        <a href="/listings/<%= listing._id %>" class="btn btn-primary mb-3">
                            View
                        </a>
                    </div>
                </div>
            </div>
            <% } %>

        </div>
        <% } %>

    </div>
</div>