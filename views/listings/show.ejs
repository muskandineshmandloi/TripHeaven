<% layout("/layouts/boilerplate") %>

<body>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3><b><%= listing.title %></b></h3>
        </div>

        <div class="card col-6 offset-3 show-card">
            <img src="<%= listing.image.url %>" alt="listing_image" class="card-img-top show-img">

            <div class="card-body">
                <p class="card-text">
                    <i><%= listing.owner?.username || "Unknown User" %></i>
                </p>

                <p class="card-text"><%= listing.description %></p>
                <p class="card-text">&#8377;<%= listing.price.toLocaleString("en-IN") %></p>
                <p class="card-text"><%= listing.location %></p>
                <p class="card-text"><%= listing.country %></p>
            </div>
        </div>
    </div>

    <% const isOwner = currUser && listing.owner && currUser._id.equals(listing.owner._id); %>

    <% if (currUser && !isOwner) { %>

    <div class="row mt-4">
        <div class="col-6 offset-3">

            <hr>
            <h4>Book this property</h4>

            <form action="/listings/<%= listing._id %>/book" method="POST">

                <div class="mb-3">
                    <label>Check In</label>
                    <input
                        type="date"
                        id="checkIn"
                        name="booking[checkIn]"
                        class="form-control"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label>Check Out</label>
                    <input
                        type="date"
                        id="checkOut"
                        name="booking[checkOut]"
                        class="form-control"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label>Guests</label>
                    <input type="number" name="booking[guests]" min="1" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label>Rooms</label>
                    <input
                        type="number"
                        id="rooms"
                        name="booking[rooms]"
                        min="1"
                        value="1"
                        class="form-control"
                        required
                    >
                </div>

                <div class="card mb-3">
                    <div class="card-body">

                        <h5>Booking Summary</h5>

                        <p>
                            Price / Night :
                            ₹<span id="pricePerNight"><%= listing.price %></span>
                        </p>

                        <p>
                            Nights :
                            <span id="totalNights">0</span>
                        </p>

                        <p>
                            Rooms :
                            <span id="totalRooms">1</span>
                        </p>

                        <hr>

                        <h5>
                            Estimated Total :
                            ₹<span id="estimatedTotal">0</span>
                        </h5>

                    </div>
                </div>

                <button class="btn btn-success">Book Now</button>

            </form>

            <hr>
        </div>
    </div>

    <% } else if (!currUser) { %>

    <div class="col-6 offset-3 mt-4">
        <p>Please login to book this property.</p>
    </div>

    <% } %>


    <!-- EDIT / DELETE -->
    <% if (isOwner) { %>
        <div class="btns mb-4">
            <a href="/listings/<%= listing._id %>/edit"
               class="btn btn-dark col-1 offset-3 edit-btn">
               Edit
            </a>

            <form action="/listings/<%= listing._id %>?_method=DELETE"
                  method="post">
                <button class="btn btn-dark offset-5">Delete</button>
            </form>
        </div>
    <% } %>

    <!-- REVIEW FORM (only non-owner users) -->
    <% if (currUser && !isOwner) { %>
        <div class="row">
            <div class="col-8 offset-3">
                <hr>
                <h4>Leave a review</h4>

                <form action="/listings/<%= listing._id %>/reviews"
                      method="post"
                      class="needs-validation"
                      novalidate>

                    <div class="mb-1 mt-3">
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate"
                                   name="review[rating]" value="1" checked />

                            <input type="radio" id="r1" name="review[rating]" value="1" />
                            <label for="r1">1 star</label>

                            <input type="radio" id="r2" name="review[rating]" value="2" />
                            <label for="r2">2 stars</label>

                            <input type="radio" id="r3" name="review[rating]" value="3" />
                            <label for="r3">3 stars</label>

                            <input type="radio" id="r4" name="review[rating]" value="4" />
                            <label for="r4">4 stars</label>

                            <input type="radio" id="r5" name="review[rating]" value="5" />
                            <label for="r5">5 stars</label>
                        </fieldset>
                    </div>

                    <div class="mb-3 mt-1">
                        <label class="form-label">Name</label>
                        <input type="text"
                               name="review[name]"
                               class="form-control"
                               required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Comments</label>
                        <textarea name="review[comment]"
                                  class="form-control"
                                  rows="5"
                                  required></textarea>
                    </div>

                    <button class="btn btn-outline-primary submit-btn">Submit</button>
                </form>

                <hr>
            </div>
        </div>
    <% } %>

    
    <!-- REVIEWS -->
    <div class="col-6 offset-3">
        <div class="row">

            <% if (listing.reviews && listing.reviews.length > 0) { %>
                <p><b>All Reviews</b></p>

                <% for (let review of listing.reviews) { %>
                    <div class="card mb-3 col-md-5 ms-3">
                        <div class="card-body">

                            <h5 class="card-title">
                                <%= review.author?.username || "Unknown User" %>
                            </h5>

                            <p class="starability-result result"
                               data-rating="<%= review.rating %>"></p>

                            <p><%= review.comment %></p>
                        </div>

                        <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                  method="post"
                                  class="mb-3 mt-2">
                                <button class="btn btn-sm btn-dark">Delete</button>
                            </form>
                        <% } %>
                    </div>
                <% } %>
            <% } %>

        </div>
    </div>

    <!-- MAP -->
    <div class="row mt-3 mb-5">
        <div class="col-6 offset-3">

            <h3>Where you'll be</h3>

            <div class="map-container">
                <div id="map"></div>
            </div>

        </div>
    </div>

    <script>
        const coordinates = <%- JSON.stringify(listing.geometry?.coordinates || []) %>;
    </script>

    <script>
        const listingPrice = <%= listing.price %>;
    </script>

    <script src="/js/booking.js"></script>

    <script src="/js/map.js"></script>
</body>