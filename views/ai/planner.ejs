<%- layout("/layouts/boilerplate") %>

<style>

.generate{
    border-radius:1rem !important;
    background:#fe433d !important;
    color:black !important;
    padding:0 1rem;
    height:2.5rem;
}

.ai-result{
    margin-top:40px;
}

.ai-card{
    border:none;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.ai-card h2{
    color:#fe433d;
}

.ai-content h1,
.ai-content h2,
.ai-content h3{
    color:#fe433d;
    margin-top:25px;
    font-weight:700;
}

.ai-content ul{
    padding-left:25px;
}

.ai-content li{
    margin-bottom:10px;
}

.ai-content p{
    line-height:1.8;
    color:#555;
}

.ai-content strong{
    color:#222;
}

.ai-content hr{
    margin:25px 0;
}

</style>

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            <i class="fa-solid fa-wand-magic-sparkles" style="color:#fe433d;"></i>
            AI Trip Planner
        </h1>

        <p class="text-muted">
            Plan your perfect trip using Artificial Intelligence.
        </p>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-5">

                    <form action="/ai/trip-planner" method="POST">

                        <div class="mb-4">

                            <label class="form-label">
                                Destination
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                name="destination"
                                placeholder="Goa"
                                required
                                value="<%= destination || '' %>">

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Budget
                                <i class="fa-solid fa-indian-rupee-sign text-danger"></i>
                            </label>

                            <input
                                type="number"
                                class="form-control"
                                name="budget"
                                placeholder="30000"
                                required
                                value="<%= budget || '' %>">

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Number of Days
                            </label>

                            <input
                                type="number"
                                class="form-control"
                                name="days"
                                min="1"
                                required
                                value="<%= days || '' %>">

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Travel Style
                            </label>

                            <select class="form-select" name="style">
                                <option>Budget</option>
                                <option>Luxury</option>
                                <option>Family</option>
                                <option>Solo</option>
                                <option>Couple</option>
                            </select>

                        </div>

                        <button class="btn w-100 generate">
                            Generate AI Plan
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <% if (htmlPlan) { %>

    <div class="row justify-content-center ai-result">

        <div class="col-lg-8">

            <div class="card ai-card">

                <div class="card-body p-5">

                    <h2 class="fw-bold mb-4">
                        <i class="fa-solid fa-wand-magic-sparkles" style="color:#fe433d;"></i>
                        Your AI Travel Plan
                    </h2>

                    <div class="ai-content">
                        <%- htmlPlan %>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <% } %>

</div>