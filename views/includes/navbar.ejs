              type="search"
              name="destination"
              placeholder="Search Destination i.e., Mumbai, USA"
              required
            />
            <div class="invalid-feedback">
              Please enter a valid destination
            </div>
          </div>
          <button class="btn search-btn" style="border: none !important;" type="submit">Search</button>
        </form>
      </div>
    
      <div class="navbar-nav ms-auto">

