  .navbar-collapse.show {
    background-color: black;
    padding: 1rem;
  }

  .navbar-collapse .nav-link {
    color: white !important;
  }

  .navbar-collapse .btn {
    color: white;
    border-color: white;
  }

  .navbar-collapse input {
    border-radius: 1rem;
    background-color: white !important;
    color: black;
    border: 1px solid #555;
    padding: 0 1rem 0 1rem;
    height: 2rem;
    font-size: 0.75rem;
  }


  .navbar-collapse {
    transition: all 0.5s ease;
  }


  
}

.navbar-collapse input {
    border-radius: 1rem;
    background-color: white !important;
    color: white;
    border: 1px solid #555;
    padding: 0 1rem 0 1rem;
    height: 2rem;
    font-size: 0.85rem;
    width: 25rem;
  }

.search-btn{
    border-radius: 1rem !important;
    background-color: #fe433d !important;
